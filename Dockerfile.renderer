FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        fonts-dejavu-core \
        fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_renderer.txt /app/requirements.txt

RUN pip install \
    --no-cache-dir \
    -r /app/requirements.txt

COPY contentforge_pillow_renderer_sidecar.py /app/contentforge_pillow_renderer_sidecar.py
COPY contentforge_renderer_api_sidecar.py /app/contentforge_renderer_api_sidecar.py

RUN mkdir -p /tmp/contentforge

EXPOSE 8000

CMD ["uvicorn", "contentforge_renderer_api_sidecar:app", "--host", "0.0.0.0", "--port", "8000"]
